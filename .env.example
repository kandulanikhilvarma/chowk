# Supabase project API URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Safe in the browser. RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Public base URL, used for auth redirects, sitemap and Open Graph links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web push. Generate a VAPID keypair and keep the private half on the sender, never here.
# Leave blank to hide the alerts toggle entirely.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional. A Slack, Discord or alerting webhook that receives one message per server error.
# Errors always go to the Vercel logs as JSON lines; this only adds a ping.
ERROR_WEBHOOK_URL=
